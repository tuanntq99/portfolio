---
import { portfolioData } from '../data/portfolio';
import ThemeScript from '../components/ThemeScript.astro';
import { withBase } from '../utils/path';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { siteMetadata, personal } = portfolioData;

const { 
  title = siteMetadata.title, 
  description = siteMetadata.description, 
  ogImage = siteMetadata.ogImage 
} = Astro.props;

const fullOgImage = ogImage.startsWith('http') ? ogImage : new URL(withBase(ogImage), Astro.site).toString();
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content={personal.name} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={fullOgImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    <!-- Fonts (non-blocking for the main stylesheet) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" />

    <title>{title}</title>

    <!-- Theme Initialization Script -->
    <ThemeScript />
  </head>
  <body class="bg-slate-100 text-slate-900 dark:bg-slate-950 dark:text-slate-100 min-h-screen relative selection:bg-indigo-600 selection:text-white dark:selection:bg-indigo-500 transition-colors duration-200">
    <!-- Cybernetic grid background -->
    <div class="fixed inset-0 bg-grid-pattern opacity-25 dark:opacity-40 pointer-events-none z-0"></div>

    <!-- Main Container -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
    </div>

    <script>
      // Reveal elements with the .reveal class as they scroll into view
      const revealEls = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
