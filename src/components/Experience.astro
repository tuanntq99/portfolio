---
import { portfolioData } from '../data/portfolio';

const { experiences, education, certifications } = portfolioData;
---

<section id="experience" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 dark:bg-emerald-500/10 dark:border-emerald-500/20 text-xs font-mono font-medium dark:text-emerald-400">
        <span>Career Trajectory</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">
        Work <span class="text-gradient">Experience & Track Record</span>
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400">
        Demonstrated progression delivering high-stakes engineering initiatives, mentoring teams, and maintaining zero-regression delivery pipelines.
      </p>
    </div>

    <!-- Experience Timeline -->
    <div class="relative border-l-2 border-slate-300 dark:border-slate-800 ml-4 md:ml-32 space-y-12">
      {experiences.map((exp) => (
        <div class="relative pl-8 group">
          
          <!-- Timeline Node Point -->
          <div class={`absolute -left-[9px] top-1.5 w-4 h-4 rounded-full border-2 transition-all duration-300 ${
            exp.current 
              ? 'bg-emerald-500 border-emerald-300 ring-4 ring-emerald-500/20' 
              : 'bg-white dark:bg-slate-900 border-slate-400 dark:border-slate-600 group-hover:border-cyan-500 group-hover:bg-cyan-500'
          }`} />

          <!-- Timeline Content Card -->
          <div class="rounded-2xl bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800/90 p-6 sm:p-8 backdrop-blur-md hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-300 shadow-sm hover:shadow-md dark:shadow-xl space-y-5">
            
            <!-- Role Header -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-4 border-b border-slate-100 dark:border-slate-800/80">
              <div>
                <div class="flex items-center gap-2 flex-wrap">
                  <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-cyan-300 transition-colors">
                    {exp.role}
                  </h3>
                  {exp.current && (
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-emerald-100 text-emerald-800 border border-emerald-200 dark:bg-emerald-500/15 dark:text-emerald-400 dark:border-emerald-500/30">
                      Present
                    </span>
                  )}
                </div>
                <div class="text-sm font-medium text-slate-700 dark:text-slate-300 flex items-center gap-2 mt-1">
                  <span>{exp.company}</span>
                  <span class="text-slate-400 dark:text-slate-600">•</span>
                  <span class="text-xs font-mono text-indigo-600 dark:text-cyan-400">{exp.domain}</span>
                </div>
              </div>

              <!-- Period & Location -->
              <div class="text-left sm:text-right font-mono text-xs text-slate-500 dark:text-slate-400 space-y-1">
                <div class="font-semibold text-slate-800 dark:text-slate-300">{exp.period}</div>
                <div>{exp.location} ({exp.type})</div>
              </div>
            </div>

            <!-- Bullet Points (Quantified Achievements) -->
            <div class="space-y-2.5">
              <div class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                Key Deliverables & Business Impact:
              </div>
              <ul class="space-y-2">
                {exp.achievements.map((ach) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
                    <span class="text-indigo-600 dark:text-cyan-400 mt-1 font-bold">▹</span>
                    <span>{ach}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Tech Stack Used -->
            <div class="pt-3 border-t border-slate-100 dark:border-slate-800/80 flex flex-wrap items-center gap-2">
              <span class="text-[11px] font-mono text-slate-400 dark:text-slate-500 mr-1">Stack:</span>
              {exp.technologies.map((tech) => (
                <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 text-slate-700 border border-slate-200 dark:bg-slate-950/70 dark:text-slate-300 dark:border-slate-800">
                  {tech}
                </span>
              ))}
            </div>

          </div>
        </div>
      ))}
    </div>

    <!-- Certifications & Education Section -->
    <div class="mt-20 grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Certifications -->
      <div class="rounded-2xl bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 p-6 sm:p-8 backdrop-blur-md space-y-6 shadow-sm">
        <div class="flex items-center gap-2">
          <div class="p-2 rounded-lg bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-500/10 dark:text-amber-400 dark:border-amber-500/20">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100">Verified Certifications</h3>
        </div>

        <div class="space-y-4">
          {certifications.map((cert) => (
            <div class="p-3.5 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 flex items-center justify-between hover:border-slate-300 dark:hover:border-slate-700 transition-colors">
              <div>
                <div class="text-sm font-semibold text-slate-800 dark:text-slate-200">{cert.name}</div>
                <div class="text-xs text-slate-500 dark:text-slate-400 font-mono mt-0.5">{cert.issuer} · Issued {cert.date}</div>
              </div>
              {cert.credentialUrl && (
                <a 
                  href={cert.credentialUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="text-xs font-mono text-indigo-600 hover:text-indigo-800 dark:text-cyan-400 dark:hover:text-cyan-300 underline shrink-0 ml-3 font-semibold"
                >
                  Verify ↗
                </a>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Education -->
      <div class="rounded-2xl bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 p-6 sm:p-8 backdrop-blur-md space-y-6 shadow-sm">
        <div class="flex items-center gap-2">
          <div class="p-2 rounded-lg bg-indigo-50 text-indigo-700 border border-indigo-200 dark:bg-indigo-500/10 dark:text-indigo-400 dark:border-indigo-500/20">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path d="M12 14l9-5-9-5-9 5 9 5z" />
              <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100">Academic Foundation</h3>
        </div>

        <div class="space-y-4">
          {education.map((edu) => (
            <div class="p-4 rounded-xl bg-slate-50 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 space-y-2">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                <div class="text-sm font-semibold text-slate-800 dark:text-slate-200">{edu.degree}</div>
                <div class="text-xs font-mono text-slate-500 dark:text-slate-400">{edu.period}</div>
              </div>
              <div class="text-xs text-slate-600 dark:text-slate-400">{edu.institution} · {edu.location}</div>
              {edu.honors && (
                <div class="inline-block text-xs font-mono text-emerald-800 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 px-2 py-0.5 rounded font-medium">
                  {edu.honors}
                </div>
              )}
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>
