---
import { portfolioData } from '../data/portfolio';
import { boldify } from '../utils/format';

const { experiences, education, certifications } = portfolioData;
---

<section id="experience" class="py-16 sm:py-20 relative">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal mb-12">
      <div class="font-mono text-xs font-semibold tracking-widest text-indigo-600 dark:text-cyan-400 uppercase">04 · Experience</div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
        Where I've <span class="text-gradient">worked</span>
      </h2>
    </div>

    <!-- Timeline -->
    <div class="relative ml-2 sm:ml-4">
      <div class="absolute left-0 top-2 bottom-2 w-px bg-gradient-to-b from-indigo-500 via-cyan-500 to-transparent"></div>

      <div class="space-y-10">
        {experiences.map((exp) => (
          <div class="reveal relative pl-8 sm:pl-10">
            <span class={`absolute -left-[7px] top-2 w-[15px] h-[15px] rounded-full border-2 ${
              exp.current
                ? 'bg-emerald-500 border-emerald-200 dark:border-emerald-900 ring-4 ring-emerald-500/20'
                : 'bg-white dark:bg-slate-950 border-indigo-400'
            }`}></span>

            <div class="rounded-2xl bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 p-6 sm:p-7 shadow-sm hover:shadow-lg hover:border-indigo-300 dark:hover:border-indigo-500/40 transition-all duration-300">
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2 mb-5">
                <div>
                  <h3 class="text-xl font-bold text-slate-900 dark:text-white flex items-center gap-2 flex-wrap">
                    {exp.role}
                    <span class="text-slate-400 dark:text-slate-600 font-normal">@</span>
                    <span class="text-gradient">{exp.company}</span>
                  </h3>
                  <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">{exp.location}</div>
                </div>
                <span class={`self-start shrink-0 px-3 py-1 rounded-full text-xs font-mono font-semibold border ${
                  exp.current
                    ? 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-500/10 dark:text-emerald-400 dark:border-emerald-500/30'
                    : 'bg-slate-100 text-slate-600 border-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:border-slate-700'
                }`}>
                  {exp.period}
                </span>
              </div>

              <ul class="space-y-2.5">
                {exp.achievements.map((ach) => (
                  <li class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
                    <span class="mt-2 w-1.5 h-1.5 rounded-full bg-indigo-500 dark:bg-cyan-400 shrink-0"></span>
                    <span set:html={boldify(ach)} />
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Education -->
    <div class="reveal mt-16">
      <div class="font-mono text-xs font-semibold tracking-widest text-indigo-600 dark:text-cyan-400 uppercase mb-4">Education</div>
      {education.map((edu) => (
        <div class="glow-border rounded-2xl">
          <div class="rounded-2xl bg-white dark:bg-slate-900/80 p-6 flex flex-col sm:flex-row sm:items-center gap-4">
            <div class="p-3 rounded-xl bg-indigo-50 text-indigo-600 border border-indigo-200 dark:bg-indigo-500/10 dark:text-indigo-300 dark:border-indigo-500/30 self-start">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222" />
              </svg>
            </div>
            <div class="flex-1">
              <div class="text-base font-bold text-slate-900 dark:text-white">{edu.institution}</div>
              <div class="text-sm text-slate-600 dark:text-slate-400">{edu.degree} · Major: {edu.major}</div>
            </div>
            <span class="text-sm font-mono font-semibold text-slate-700 dark:text-slate-300 whitespace-nowrap">{edu.period}</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Certifications: hidden while the list in portfolio.ts is empty -->
    {certifications.length > 0 && (
      <div class="reveal mt-12">
        <div class="font-mono text-xs font-semibold tracking-widest text-indigo-600 dark:text-cyan-400 uppercase mb-4">Certifications</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {certifications.map((cert) => (
            <div class="rounded-2xl bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 p-5 flex items-start gap-4 hover:border-amber-300 dark:hover:border-amber-500/40 hover:shadow-lg transition-all duration-300">
              <div class="p-2.5 rounded-xl bg-amber-50 text-amber-600 border border-amber-200 dark:bg-amber-500/10 dark:text-amber-400 dark:border-amber-500/30 shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-bold text-slate-900 dark:text-white">{cert.name}</div>
                <div class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">{cert.issuer} · {cert.date}</div>
                {cert.credentialUrl && (
                  <a href={cert.credentialUrl} target="_blank" rel="noopener noreferrer" class="inline-block mt-2 text-xs font-semibold text-indigo-600 dark:text-cyan-400 hover:underline">Verify ↗</a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>
