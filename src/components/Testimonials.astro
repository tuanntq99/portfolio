---
import { portfolioData } from '../data/portfolio';

// Section renders nothing while there are no references in portfolio.ts
const { testimonials } = portfolioData;
---

{testimonials.length > 0 && (
  <section id="testimonials" class="py-16 sm:py-20 relative bg-slate-200/40 dark:bg-slate-900/30 border-y border-slate-200/80 dark:border-slate-800/60">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="reveal mb-10">
        <div class="font-mono text-xs font-semibold tracking-widest text-indigo-600 dark:text-cyan-400 uppercase">References</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
          What colleagues <span class="text-gradient">say</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {testimonials.map((t, idx) => (
          <figure class="reveal relative rounded-2xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 p-7 shadow-sm hover:shadow-lg hover:border-indigo-300 dark:hover:border-indigo-500/40 transition-all duration-300 flex flex-col" style={`--d:${(idx % 2) * 80}ms`}>
            <div class="text-5xl leading-none font-serif text-gradient mb-3">“</div>
            <blockquote class="text-sm sm:text-base text-slate-700 dark:text-slate-200 leading-relaxed flex-1">{t.quote}</blockquote>
            <figcaption class="flex items-center gap-4 pt-5 mt-6 border-t border-slate-100 dark:border-slate-800">
              {t.avatar ? (
                <img src={t.avatar} alt={t.name} class="w-11 h-11 rounded-full object-cover border-2 border-indigo-500/40" loading="lazy" />
              ) : (
                <div class="w-11 h-11 rounded-full bg-gradient-to-br from-indigo-500 to-cyan-500 flex items-center justify-center font-bold text-white text-sm">
                  {t.name.split(' ').map((n) => n[0]).slice(-2).join('')}
                </div>
              )}
              <div class="min-w-0">
                <div class="text-sm font-bold text-slate-900 dark:text-white">{t.name}</div>
                <div class="text-xs text-slate-500 dark:text-slate-400">{t.role} · <span class="text-indigo-600 dark:text-indigo-400">{t.company}</span></div>
                <div class="text-[11px] font-mono text-slate-400 dark:text-slate-500 mt-0.5">
                  {t.relationship}
                  {t.contact && (<> · <a href={t.contact} target="_blank" rel="noopener noreferrer" class="underline hover:text-indigo-500">contact</a></>)}
                </div>
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
