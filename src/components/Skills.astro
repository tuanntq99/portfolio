---
import { portfolioData } from '../data/portfolio';

const { skillCategories } = portfolioData;

const iconSvgs = {
  layout: `<svg class="w-5 h-5 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" /></svg>`,
  server: `<svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg>`,
  cloud: `<svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z" /></svg>`,
  'shield-check': `<svg class="w-5 h-5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
};
---

<section id="skills" class="py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200 dark:bg-indigo-500/10 dark:border-indigo-500/20 text-xs font-mono font-medium dark:text-indigo-400">
        <span>Tech Stack & Competencies</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-slate-100 tracking-tight">
        Engineered for <span class="text-gradient">End-to-End Delivery</span>
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400">
        Production-proven backend toolkit spanning secure Spring Boot microservices, high-availability banking integrations, relational database query optimization, and real-time Kafka event streams.
      </p>
    </div>

    <!-- Skills Category Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {skillCategories.map((category) => (
        <div class="rounded-2xl bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800/90 p-6 sm:p-8 backdrop-blur-md hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-300 shadow-sm hover:shadow-md dark:shadow-xl group">
          
          <!-- Category Header -->
          <div class="flex items-center gap-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-800">
            <div class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/60 shadow-inner" set:html={iconSvgs[category.icon as keyof typeof iconSvgs]} />
            <div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-slate-100 group-hover:text-indigo-600 dark:group-hover:text-cyan-300 transition-colors">
                {category.name}
              </h3>
              <span class="text-xs font-mono text-slate-500">
                {category.skills.length} core technologies
              </span>
            </div>
          </div>

          <!-- Skills Badges List -->
          <div class="flex flex-wrap gap-2.5">
            {category.skills.map((skill) => (
              <div class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-200 ${
                skill.featured 
                  ? 'bg-indigo-50 text-indigo-900 border border-indigo-200 dark:bg-slate-800/90 dark:text-slate-100 dark:border-indigo-500/30 hover:border-indigo-400 hover:bg-indigo-100/60 dark:hover:bg-slate-800 shadow-sm'
                  : 'bg-slate-100 text-slate-700 border border-slate-200 dark:bg-slate-950/60 dark:text-slate-300 dark:border-slate-800/80 hover:border-slate-300 dark:hover:border-slate-700 hover:text-slate-900 dark:hover:text-white'
              }`}>
                <span>{skill.name}</span>
                {skill.level && (
                  <span class={`text-[10px] font-mono px-1.5 py-0.5 rounded ${
                    skill.level === 'Expert' 
                      ? 'bg-emerald-100 text-emerald-800 border border-emerald-200 dark:bg-emerald-500/15 dark:text-emerald-400 dark:border-emerald-500/20' 
                      : skill.level === 'Advanced'
                      ? 'bg-cyan-100 text-cyan-800 border border-cyan-200 dark:bg-cyan-500/15 dark:text-cyan-400 dark:border-cyan-500/20'
                      : 'bg-slate-200 text-slate-700 dark:bg-slate-700/50 dark:text-slate-400'
                  }`}>
                    {skill.level}
                  </span>
                )}
              </div>
            ))}
          </div>

        </div>
      ))}
    </div>

    <!-- Quick Architecture & Methodology Highlights -->
    <div class="mt-12 p-6 rounded-2xl bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 shadow-sm">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center sm:text-left">
        <div class="space-y-1">
          <div class="font-bold text-sm text-slate-800 dark:text-slate-200">Architectural Paradigm</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-mono">Microservices, Event-Driven, Clean Architecture & DDD</div>
        </div>
        <div class="space-y-1">
          <div class="font-bold text-sm text-slate-800 dark:text-slate-200">Quality Strategy</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-mono">Behavior-Driven Development (BDD), Contract Testing, E2E Automation</div>
        </div>
        <div class="space-y-1">
          <div class="font-bold text-sm text-slate-800 dark:text-slate-200">DevOps Culture</div>
          <div class="text-xs text-slate-500 dark:text-slate-400 font-mono">Infrastructure as Code, Automated Quality Gates, Trunk-Based Delivery</div>
        </div>
      </div>
    </div>

  </div>
</section>
