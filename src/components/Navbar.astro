---
import { portfolioData } from '../data/portfolio';
import { withBase } from '../utils/path';

const { personal, testimonials } = portfolioData;

const navLinks = [
  { href: '#overview', label: 'Overview' },
  { href: '#metrics', label: 'Impact' },
  { href: '#skills', label: 'Skills' },
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  // Only shown when references exist in portfolio.ts
  ...(testimonials.length > 0 ? [{ href: '#testimonials', label: 'References' }] : []),
  { href: '#contact', label: 'Contact' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 backdrop-blur-md bg-white/80 dark:bg-slate-950/75 border-b border-slate-200/90 dark:border-slate-800/60" id="main-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-[72px]">

      <!-- Brand -->
      <a href="#overview" class="flex items-center gap-3 group rounded-lg p-1 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-600 via-violet-600 to-cyan-600 flex items-center justify-center font-extrabold text-white text-sm shadow-lg shadow-indigo-500/30 group-hover:rotate-6 transition-transform duration-300">
          {personal.initials}
        </div>
        <div class="leading-tight max-[359px]:hidden">
          <div class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base tracking-tight whitespace-nowrap">{personal.name}</div>
          <div class="text-[11px] text-slate-600 dark:text-slate-400 font-mono hidden sm:block">{personal.role}</div>
        </div>
      </a>

      <!-- Desktop navigation -->
      <nav class="hidden lg:flex items-center gap-1" id="desktop-nav">
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-section={link.href.slice(1)}
            class="nav-link px-3 py-1.5 text-sm font-medium text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white hover:bg-slate-200/70 dark:hover:bg-slate-800/60 rounded-lg transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Theme toggle -->
        <button
          id="theme-toggle"
          aria-label="Toggle dark/light mode"
          class="max-lg:min-h-11 max-lg:min-w-11 inline-flex items-center justify-center p-2 rounded-xl text-slate-600 hover:text-slate-900 bg-white hover:bg-slate-100 border border-slate-200 shadow-sm dark:bg-slate-900/80 dark:hover:bg-slate-800 dark:text-slate-400 dark:hover:text-slate-100 dark:border-slate-800/80 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500"
        >
          <svg class="w-5 h-5 hidden dark:block text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="w-5 h-5 block dark:hidden text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- The one and only CV download button -->
        <a
          href={withBase(personal.cvUrl)}
          download={personal.cvFileName}
          class="group relative inline-flex items-center gap-2 px-3.5 sm:px-4 py-2 min-h-11 rounded-xl text-xs sm:text-sm font-semibold text-white bg-gradient-to-r from-indigo-600 via-violet-600 to-cyan-600 bg-[length:200%_100%] bg-left hover:bg-right shadow-lg shadow-indigo-500/30 hover:shadow-cyan-500/30 transition-all duration-500 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400"
        >
          <svg class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          <span class="whitespace-nowrap"><span class="hidden sm:inline">Download </span>CV</span>
          <span class="hidden sm:inline text-[11px] font-mono px-1.5 py-0.5 rounded-md bg-black/25">PDF</span>
        </a>

        <!-- Mobile menu toggle -->
        <button
          id="mobile-menu-btn"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          class="lg:hidden min-h-11 min-w-11 inline-flex items-center justify-center p-2 rounded-xl text-slate-600 hover:text-slate-900 bg-white border border-slate-200 shadow-sm dark:bg-slate-900/80 dark:border-slate-800/80 dark:text-slate-400 dark:hover:text-slate-100 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500"
        >
          <svg id="menu-icon-bars" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-950/95 px-4 pt-2 pb-5 space-y-1 shadow-2xl">
    {navLinks.map((link) => (
      <a href={link.href} class="mobile-nav-link block px-3 py-2 rounded-lg text-base font-medium text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-slate-800/70">
        {link.label}
      </a>
    ))}
    <div class="pt-3 mt-2 border-t border-slate-200 dark:border-slate-800 flex items-center justify-between">
      <span class="text-xs text-slate-500 dark:text-slate-400">Email</span>
      <a href={`mailto:${personal.email}`} class="text-xs font-mono text-indigo-600 dark:text-cyan-400 underline">{personal.email}</a>
    </div>
  </div>
</header>

<script>
  // Theme toggle
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  // Mobile drawer
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const barsIcon = document.getElementById('menu-icon-bars');
  const closeIcon = document.getElementById('menu-icon-close');

  const setMenu = (open: boolean) => {
    mobileMenu?.classList.toggle('hidden', !open);
    barsIcon?.classList.toggle('hidden', open);
    closeIcon?.classList.toggle('hidden', !open);
    mobileBtn?.setAttribute('aria-expanded', String(open));
  };

  mobileBtn?.addEventListener('click', () => setMenu(mobileMenu?.classList.contains('hidden') ?? false));
  document.querySelectorAll('.mobile-nav-link').forEach((link) => link.addEventListener('click', () => setMenu(false)));

  // Highlight the nav link of the section currently in view
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const sections = Array.from(navLinks)
    .map((link) => document.getElementById(link.dataset.section || ''))
    .filter((el): el is HTMLElement => !!el);

  const activeClasses = ['text-indigo-600', 'dark:text-cyan-300', 'bg-indigo-50', 'dark:bg-slate-800/70'];
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinks.forEach((link) => {
          const active = link.dataset.section === entry.target.id;
          activeClasses.forEach((c) => link.classList.toggle(c, active));
        });
      });
    },
    { rootMargin: '-45% 0px -50% 0px' }
  );
  sections.forEach((s) => spy.observe(s));
</script>
