---
import { portfolioData } from '../data/portfolio';

const { metrics } = portfolioData;

const colorAccents = [
  { text: 'from-amber-400 to-orange-400', border: 'hover:border-amber-500/40', badge: 'bg-amber-500/10 text-amber-400 border-amber-500/20' },
  { text: 'from-emerald-400 to-teal-400', border: 'hover:border-emerald-500/40', badge: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' },
  { text: 'from-cyan-400 to-blue-400', border: 'hover:border-cyan-500/40', badge: 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20' },
  { text: 'from-indigo-400 to-purple-400', border: 'hover:border-indigo-500/40', badge: 'bg-indigo-500/10 text-indigo-400 border-indigo-500/20' },
];
---

<section id="metrics" class="py-12 relative border-y border-slate-200/80 dark:border-slate-800/60 bg-slate-200/40 dark:bg-slate-900/40 backdrop-blur-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header Tag -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-mono font-semibold tracking-wider text-indigo-600 dark:text-cyan-400 uppercase">
          <span class="w-2 h-2 rounded-sm bg-indigo-600 dark:bg-cyan-400"></span>
          Executive Summary & Quantified Impact
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-slate-100 tracking-tight mt-1">
          Measurable Engineering Outcomes
        </h2>
      </div>
      <div class="text-xs font-mono text-slate-500 dark:text-slate-400 max-w-sm">
        Metrics gathered across enterprise production workloads, high-volume banking portals, and cloud microservices.
      </div>
    </div>

    <!-- Metrics 4-Column Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {metrics.map((metric, idx) => {
        const accent = colorAccents[idx % colorAccents.length];
        return (
          <div class={`relative rounded-2xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800/90 p-6 transition-all duration-300 hover:-translate-y-1 ${accent.border} shadow-sm hover:shadow-md group`}>
            
            <!-- Value -->
            <div class={`text-3xl sm:text-4xl font-extrabold bg-gradient-to-r ${accent.text} bg-clip-text text-transparent tracking-tight font-mono mb-2`}>
              {metric.value}
            </div>

            <!-- Label -->
            <div class="text-base font-semibold text-slate-800 dark:text-slate-200 mb-2">
              {metric.label}
            </div>

            <!-- Description -->
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
              {metric.description}
            </p>

            <!-- Subtle corner decor -->
            <div class="absolute top-3 right-3 text-[10px] font-mono text-slate-400 dark:text-slate-600 group-hover:text-slate-600 dark:group-hover:text-slate-400 transition-colors">
              0{idx + 1}
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
