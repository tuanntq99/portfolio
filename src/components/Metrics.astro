---
import { portfolioData } from '../data/portfolio';

const { metrics } = portfolioData;

const accents = [
  { text: 'from-indigo-600 to-violet-600 dark:from-indigo-400 dark:to-violet-400', glow: 'group-hover:shadow-indigo-500/20', bar: 'from-indigo-500 to-violet-500' },
  { text: 'from-amber-600 to-orange-700 dark:from-amber-400 dark:to-orange-400', glow: 'group-hover:shadow-amber-500/20', bar: 'from-amber-500 to-orange-500' },
  { text: 'from-cyan-700 to-blue-700 dark:from-cyan-400 dark:to-blue-400', glow: 'group-hover:shadow-cyan-500/20', bar: 'from-cyan-500 to-blue-500' },
  { text: 'from-emerald-700 to-teal-700 dark:from-emerald-400 dark:to-teal-400', glow: 'group-hover:shadow-emerald-500/20', bar: 'from-emerald-500 to-teal-500' },
];
---

<section id="metrics" class="py-16 sm:py-20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <div class="font-mono text-xs font-semibold tracking-widest text-indigo-600 dark:text-cyan-400 uppercase">01 · Impact</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
          Results in <span class="text-gradient">numbers</span>
        </h2>
      </div>
      <p class="text-sm text-slate-600 dark:text-slate-400 max-w-sm">Measured outcomes from production systems I have built and optimized.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {metrics.map((metric, idx) => {
        const a = accents[idx % accents.length];
        return (
          <div class={`reveal group relative overflow-hidden rounded-2xl bg-white dark:bg-slate-900/70 border border-slate-200 dark:border-slate-800 p-6 shadow-sm hover:shadow-xl ${a.glow} hover:-translate-y-1 transition-all duration-300`} style={`--d:${idx * 70}ms`}>
            <div class={`absolute inset-x-0 top-0 h-1 bg-gradient-to-r ${a.bar} opacity-70 group-hover:opacity-100 transition-opacity`}></div>
            <div class={`text-5xl font-extrabold tracking-tight bg-gradient-to-r ${a.text} bg-clip-text text-transparent`}>
              {metric.value}
            </div>
            <div class="mt-3 text-base font-bold text-slate-800 dark:text-slate-100">{metric.label}</div>
            <p class="mt-1.5 text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{metric.description}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
