---
import { portfolioData } from '../data/portfolio';

const { projects } = portfolioData;
const companies = ['All', ...new Set(projects.map((p) => p.company))];

const banners = [
  'from-indigo-600 via-violet-600 to-purple-700',
  'from-cyan-600 via-sky-600 to-indigo-700',
  'from-fuchsia-600 via-purple-600 to-indigo-700',
  'from-emerald-600 via-teal-600 to-cyan-700',
  'from-amber-500 via-orange-600 to-rose-600',
];
---

<section id="projects" class="py-16 sm:py-20 relative bg-slate-200/40 dark:bg-slate-900/30 border-y border-slate-200/80 dark:border-slate-800/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
      <div>
        <div class="font-mono text-xs font-semibold tracking-widest text-indigo-600 dark:text-cyan-400 uppercase">03 · Projects</div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight mt-2">
          Key <span class="text-gradient">projects</span>
        </h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 max-w-xl mt-2">
          Production systems across enterprise banking, photo kiosks and healthcare.
        </p>
      </div>

      <div class="flex flex-wrap gap-1.5 p-1.5 rounded-xl bg-white dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 shadow-sm self-start md:self-auto" role="tablist">
        {companies.map((c, idx) => (
          <button
            class="project-filter-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white data-[active=true]:bg-indigo-600 data-[active=true]:text-white dark:data-[active=true]:text-white data-[active=true]:shadow-sm"
            data-company={c}
            data-active={idx === 0 ? 'true' : 'false'}
            role="tab"
          >
            {c}
          </button>
        ))}
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project, idx) => (
        <article
          class="project-card reveal group flex flex-col rounded-2xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-2xl hover:shadow-indigo-500/10 hover:-translate-y-1.5 transition-all duration-300"
          data-company={project.company}
          style={`--d:${(idx % 3) * 80}ms`}
        >
          <!-- Banner -->
          <div class={`relative h-36 bg-gradient-to-br ${banners[idx % banners.length]} p-5 flex flex-col justify-between overflow-hidden`}>
            <div class="absolute inset-0 bg-grid-pattern opacity-30"></div>
            <div class="absolute -right-8 -bottom-10 w-40 h-40 rounded-full bg-white/10 blur-2xl group-hover:scale-125 transition-transform duration-500"></div>
            <div class="relative flex items-center justify-between">
              <span class="px-2.5 py-1 rounded-md text-[11px] font-mono font-semibold bg-black/25 text-white backdrop-blur-sm border border-white/20">
                {project.company}
              </span>
              {project.link && (
                <a href={project.link} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-white/90 hover:text-white underline underline-offset-2">Link ↗</a>
              )}
            </div>
            <div class="relative">
              <h3 class="text-2xl font-extrabold text-white tracking-tight drop-shadow">{project.title}</h3>
              <p class="text-xs text-white/80 mt-0.5">{project.subtitle}</p>
            </div>
          </div>

          <!-- Body -->
          <div class="flex-1 flex flex-col p-5 gap-4">
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">{project.description}</p>

            {project.highlights && (
              <ul class="space-y-1.5">
                {project.highlights.map((hl) => (
                  <li class="flex items-start gap-2 text-xs text-slate-700 dark:text-slate-300">
                    <span class="text-emerald-600 dark:text-emerald-400 font-bold">✓</span>
                    <span>{hl}</span>
                  </li>
                ))}
              </ul>
            )}

            <div class="mt-auto pt-4 border-t border-slate-100 dark:border-slate-800 flex flex-wrap gap-1.5">
              {project.technologies.map((tech) => (
                <span class="px-2 py-0.5 rounded-md text-[11px] font-mono bg-slate-100 text-slate-700 border border-slate-200 dark:bg-slate-800/80 dark:text-slate-300 dark:border-slate-700/60">
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.project-filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.dataset.company;
      filterBtns.forEach((b) => (b.dataset.active = String(b === btn)));
      cards.forEach((card) => {
        const show = selected === 'All' || card.dataset.company === selected;
        card.classList.toggle('hidden', !show);
        if (show) card.classList.add('is-visible');
      });
    });
  });
</script>
